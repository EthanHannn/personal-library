        "allowedHosts": ["www.biquge365.net"],
        "charset": "utf-8",
        "intervalMs": 5000,
        "book": {
          "title": {"selector": "meta[property=\"og:novel:book_name\"]", "attr": "content"},
          "author": {"selector": "meta[property=\"og:novel:author\"]", "attr": "content"},
          "intro": {"selector": "meta[property=\"og:description\"]", "attr": "content"},
          "category": {"selector": "meta[property=\"og:novel:category\"]", "attr": "content"},
          "toc": {"selector": ".gongneng a[href^=\"/newbook/\"]", "attr": "href"},
          "status": {"selector": ".xinxi > span:nth-child(3)", "trimPrefix": "状态："}
        },
        "toc": {
          "items": ".border ul li a",
          "title": {"selector": "."},
          "link": {"selector": ".", "attr": "href"}
        },
        "chapter": {
          "title": {"selector": "#neirong h1"},
          "content": {"selector": "#txt"},
          "dropLines": ["一秒记住【笔趣阁】biquge365.net，更新快，无弹窗！"]
        }
      },
      "sample": {
